<div id="contents">
    <div class="box">
        <div>
            <div class="body">
                <h1>Travel</h1>

                <ul id="sites">
                    {{#each trips}}
                    <li>
                        <a href="/travel">
                            <img src="/images/{{image}}" alt="{{name}}">
                        </a>

                        <h2>
                            <a href="/travel">{{name}}</a>
                        </h2>

                        <p>{{description}}</p>

                        <p>
                            <strong>Length:</strong> {{length}}<br>
                            <strong>Start:</strong> {{start}}<br>
                            <strong>Resort:</strong> {{resort}}<br>
                            <strong>Price per person:</strong> ${{perPerson}}
                        </p>
                    </li>
                    {{/each}}
                </ul>

            </div>
        </div>
    </div>
</div>
